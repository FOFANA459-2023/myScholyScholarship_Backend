# ---------------------------------------------------------------------------
# Database (Supabase Postgres)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
# 6543 = Supabase transaction pooler (auto-detected), 5432 = direct connection
DB_PORT=6543
DB_SSLMODE=require
# Optional. Set to "transaction" to force pooler-safe behaviour on other ports.
# DB_POOL_MODE=transaction
# Persistent connection lifetime in seconds; ignored on the transaction pooler.
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma separated. Falls back to a sensible default list when unset.
# In production set these to the real backend hostname (see ORACLE_DEPLOY.md),
# e.g. DJANGO_ALLOWED_HOSTS=api.yourdomain.com,localhost,127.0.0.1
# DJANGO_ALLOWED_HOSTS=myscholyscholarship-backend.onrender.com,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://myscholy.vercel.app
# DJANGO_CORS_ALLOWED_ORIGINS=https://myscholy.vercel.app,http://localhost:5173
# DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Email (Resend - signup, password reset, contact form)
# ---------------------------------------------------------------------------
# SECRET - server-side only. Create the key at https://resend.com/api-keys
# with "Sending access" permission only, paste it into your local .env (this
# file is only a template; .env is gitignored) and into the production server's
# .env (Oracle VM) or dashboard (Render). Never commit it or expose it to the
# frontend build.
# RESEND_API_KEY=
#
# With Resend, the from address must use a domain verified at
# https://resend.com/domains. "MyScholy <onboarding@resend.dev>" works for
# testing, but can only deliver to your own Resend account email.
# DEFAULT_FROM_EMAIL=MyScholy <no-reply@yourdomain.com>

# ---------------------------------------------------------------------------
# Email fallback (SMTP - used only when RESEND_API_KEY is unset)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY and EMAIL_HOST_PASSWORD, emails print to the console
# (local development). For Gmail, generate an app password: Google account ->
# Security -> 2-Step Verification -> App passwords.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=myscholy@gmail.com
# EMAIL_HOST_PASSWORD=
# Inbox that receives public contact-form submissions.
# CONTACT_INBOX=myscholy@gmail.com
# Where emailed reset links point. Set to the deployed frontend in production.
# FRONTEND_URL=http://localhost:5173
# Reset link lifetime in seconds (default 1 hour).
# PASSWORD_RESET_TIMEOUT=3600

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------
# Without this the app uses per-process local memory, which still works but is
# not shared between Gunicorn workers. Set it in production for a shared cache.
# REDIS_URL=redis://default:password@host:6379/0
