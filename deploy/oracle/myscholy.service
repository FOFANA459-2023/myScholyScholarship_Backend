# Gunicorn service for the MyScholy backend on an Oracle Cloud VM.
# Copy to /etc/systemd/system/myscholy.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now myscholy
#
# Adjust paths if you cloned the repo somewhere other than
# /home/ubuntu/myscholy-backend.

[Unit]
Description=MyScholy Django backend (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/myscholy-backend
# Settings are read from /home/ubuntu/myscholy-backend/.env by python-dotenv.
# 2 workers suits the 1 GB E2.1.Micro shape; raise to 3 on a larger VM.
ExecStart=/home/ubuntu/myscholy-backend/venv/bin/gunicorn \
    scholarship_backend.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
